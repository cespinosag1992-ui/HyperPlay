#version 450
// HyperFG 3/3: fotograma intermedio (t = 0.5) por warping bidireccional, con tres escudos:
//  1. HUD / estático: si |actual - anterior| < umbral en el píxel, se copia el actual tal cual.
//  2. Corte de escena: si la diferencia media global de la pirámide 1/8 supera el umbral, todo el
//     frame es el actual (sin fantasmas ni frames borrosos al cambiar de sala, pausa o destello).
//  3. Confianza / desoclusión: si lo reproyectado desde el anterior y desde el actual discrepan,
//     se pasa suavemente al actual en vez de estirar píxeles.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D prevC;
layout(set = 0, binding = 1) uniform sampler2D currC;
layout(set = 0, binding = 2) uniform sampler2D flowTex;   // RG16F a 1/8, filtrado lineal
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 4) readonly buffer Stats { uint diffSum; uint count; } stats;

layout(push_constant) uniform P {
    vec2 invSize;
    float staticThr;   // |Δcolor| bajo el que el píxel es estático
    float confThr;     // discrepancia a partir de la que se desconfía del warp
    float cutThr;      // diferencia media de luminancia (0..1) de corte de escena
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(outImg)))) return;
    vec2 uv = (vec2(p) + 0.5) * pc.invSize;
    vec3 c0 = textureLod(currC, uv, 0.0).rgb;

    // Escudo 2: corte de escena.
    if (stats.count > 0u && (float(stats.diffSum) / 1024.0) / float(stats.count) > pc.cutThr) {
        imageStore(outImg, p, vec4(c0, 1.0));
        return;
    }
    // Escudo 1: HUD y elementos estáticos (movimiento forzado a cero).
    vec3 p0 = textureLod(prevC, uv, 0.0).rgb;
    if (length(c0 - p0) < pc.staticThr) {
        imageStore(outImg, p, vec4(c0, 1.0));
        return;
    }
    // Warping bidireccional al punto medio: m = q + F/2 -> anterior(m + F/2), actual(m - F/2).
    vec2 F = textureLod(flowTex, uv, 0.0).rg;
    vec2 h = F * 0.5 * pc.invSize;
    vec3 a = textureLod(prevC, uv + h, 0.0).rgb;
    vec3 b = textureLod(currC, uv - h, 0.0).rgb;
    // Escudo 3: confianza (desoclusión, bordes rápidos): vuelta suave al actual.
    float w = smoothstep(pc.confThr, pc.confThr * 2.0, length(a - b));
    imageStore(outImg, p, vec4(mix(0.5 * (a + b), c0, w), 1.0));
}
