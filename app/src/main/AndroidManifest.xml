<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Acceso a carpetas de juegos portables en /sdcard (Download, Games, ...). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Descarga de paquetes Turnip (TurnipDriverManager.downloadPackage). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Rumble XInput: vibradores de los mandos (InputDevice.getVibratorManager) y del teléfono. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Quick Resume: el proceso sigue vivo con el juego congelado en memoria. Los juegos corren
         en su propio proceso (":game", session/GameProcess.kt); el launcher, en el principal. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Actualizaciones desde GitHub Releases (instalación por encima con PackageInstaller). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".HyperPlayApp"
        android:allowBackup="false"
        android:allowNativeHeapPointerTagging="false"
        android:appCategory="game"
        android:isGame="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameSessionActivity"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <service
            android:name=".QuickResumeService"
            android:process=":game"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantiene en memoria un juego suspendido (Quick Resume) para reanudarlo al instante." />
        </service>

        <receiver
            android:name=".update.AppUpdater$StatusReceiver"
            android:exported="false" />
        <!-- Tras actualizarse, la app reabre el launcher sola. -->
        <receiver
            android:name=".update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
