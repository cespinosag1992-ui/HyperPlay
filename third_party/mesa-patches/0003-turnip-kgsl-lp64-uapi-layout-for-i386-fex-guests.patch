-	unsigned long gmem_gpubaseaddr;
+	__hp_kgsl_ulong gmem_gpubaseaddr;
 	/*
 	 * This field contains the adreno revision
 	 * number 200, 205, 220, etc...
 	 */
 	unsigned int gpu_id;
-	__kernel_size_t gmem_sizebytes;
+	__hp_kgsl_size_t gmem_sizebytes;
 };
 
