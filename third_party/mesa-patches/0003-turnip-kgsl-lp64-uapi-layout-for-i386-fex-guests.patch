From: HyperPlay <hyperplay@localhost>
Subject: [PATCH] turnip/kgsl: LP64 uapi layouts for i386 builds run by FEX

FEX-Emu runs i386 guest code inside a 64-bit host process and forwards KGSL
ioctls (type 0x09) to the kernel unchanged, so the kernel decodes them with
its native LP64 struct layouts (the compat_ioctl path is never taken). On
__i386__, widen every unsigned long / __kernel_size_t / pointer member of
msm_kgsl.h to an 8-byte aligned 64-bit slot and give 64-bit members 8-byte
alignment, so sizes and offsets (and thus the ioctl numbers) match x86_64 /
aarch64 exactly. Verified with an offsetof/sizeof probe over all 512 struct
members: i386 (patched) == x86_64 == aarch64. No-op for every other arch.
Define KGSL_I386_NATIVE_ABI to get the real 32-bit ABI back.

--- a/src/freedreno/vulkan/msm_kgsl.h
+++ b/src/freedreno/vulkan/msm_kgsl.h
@@ -11,6 +11,30 @@
 #include <linux/ioctl.h>
 
 /*
+ * HyperPlay (patch 0003): i386 Turnip running as FEX guest code. FEX executes
+ * 32-bit guests inside a 64-bit host process and forwards KGSL ioctls (type
+ * 0x09) unchanged, so the kernel decodes them with its native LP64 layouts
+ * (no compat_ioctl path). On __i386__ every unsigned long, __kernel_size_t and
+ * pointer member is widened to an 8-byte aligned 64-bit slot and 64-bit
+ * members get the LP64 8-byte alignment. Pointer slots keep the pointer in
+ * the low half and a zero high half (designated initializers zero it). Other
+ * architectures keep the original types.
+ */
+#if defined(__i386__) && !defined(KGSL_I386_NATIVE_ABI)
+typedef __u64 __hp_kgsl_ulong __attribute__((aligned(8)));
+typedef __u64 __hp_kgsl_size_t __attribute__((aligned(8)));
+typedef __u64 __hp_kgsl_u64 __attribute__((aligned(8)));
+typedef __s64 __hp_kgsl_s64 __attribute__((aligned(8)));
+#define __HP_KGSL_PTR(name) name __attribute__((aligned(8))); __u32 __hp_kgsl_hi_##name
+#else
+typedef unsigned long __hp_kgsl_ulong;
+typedef __kernel_size_t __hp_kgsl_size_t;
+typedef __u64 __hp_kgsl_u64;
+typedef __s64 __hp_kgsl_s64;
+#define __HP_KGSL_PTR(name) name
+#endif
+
+/*
  * The KGSL version has proven not to be very useful in userspace if features
  * are cherry picked into other trees out of order so it is frozen as of 3.14.
  * It is left here for backward compatibility and as a reminder that
@@ -272,13 +296,13 @@
 	 */
